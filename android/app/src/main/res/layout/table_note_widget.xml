<?xml version="1.0" encoding="utf-8"?>
<!-- Widget artik bir tablo cizer. Eskiden burada bes sabit satirlik bir
     liste ve ustunde iri bir sayi vardi; sayinin kapladigi yer tabloya
     verildi, satirlar da sabit olmaktan cikip saglayici tarafindan
     widget_grid icine eklenir oldu. Boylece sutun sayisi widget'in
     genisligine gore degisebiliyor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Table Note" android:textSize="17sp" android:textStyle="bold"
            android:textColor="#172554" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_settings" android:layout_width="36dp" android:layout_height="match_parent"
            android:gravity="center" android:text="⚙" android:textSize="22sp" android:textColor="#172554"/>
    </LinearLayout>
    <!-- Kayit sayisi ve secilmisse toplam, tek satirda. -->
    <TextView android:id="@+id/widget_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" android:textSize="11sp" android:textColor="#576885"
        android:maxLines="2" android:ellipsize="end"/>

    <LinearLayout android:id="@+id/widget_grid" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"/>

    <TextView android:id="@+id/widget_rows_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="end" android:textSize="10sp" android:textColor="#576885"
        android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:id="@+id/widget_add" android:layout_width="match_parent" android:layout_height="34dp"
        android:gravity="center" android:text="Table Note" android:textSize="13sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:background="@drawable/widget_button" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
