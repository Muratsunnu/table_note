<?xml version="1.0" encoding="utf-8"?>
<!-- Izgaranin tek satiri. Saglayici bunu satir sayisi kadar cogaltip
     widget_grid icine ekler; kullanilmayan hucreler GONE yapilir. GONE
     olan cocuk agirlik harcamadigi icin kalan hucreler genisligi kendi
     aralarinda paylasir. Ilk sutun 2 agirlik alir: hem tablonun ilk
     sutunu hem de cetelenin oge adi yanindakilerden uzundur. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grid_row" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="horizontal"
    android:baselineAligned="false">
    <TextView android:id="@+id/grid_cell_0" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="2"
        android:paddingStart="4dp" android:paddingEnd="4dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/grid_cell_1" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:paddingStart="4dp" android:paddingEnd="4dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/grid_cell_2" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:paddingStart="4dp" android:paddingEnd="4dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/grid_cell_3" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:paddingStart="4dp" android:paddingEnd="4dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/grid_cell_4" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:paddingStart="4dp" android:paddingEnd="4dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
